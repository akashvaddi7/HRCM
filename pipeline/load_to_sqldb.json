											"type": "Expression"
										}
									}
								}
							],
							"outputs": [
								{
									"referenceName": "load_ds_sql",
									"type": "DatasetReference",
									"parameters": {
										"Table_name": "@item().name",
										"DB_Name": {
											"value": "@pipeline().parameters.FolderDB_Name",
											"type": "Expression"
										}
									}
								}
							]
						}
					]
				}
			}
		],
		"parameters": {
			"FolderDB_Name": {
				"type": "string"
			}
		},
