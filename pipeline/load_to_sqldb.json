				"dependsOn": [
					{
						"activity": "Get_hospital_list",
						"dependencyConditions": [
							"Succeeded"
						]
					}
				],
				"userProperties": [],
				"typeProperties": {
					"items": {
						"value": "@activity('Get_hospital_list').output.childItems",
						"type": "Expression"
