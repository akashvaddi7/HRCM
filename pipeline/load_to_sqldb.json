{
	"name": "load_to_sqldb",
	"properties": {
		"activities": [
			{
				"name": "Get_hospital_list",
				"type": "GetMetadata",
				"dependsOn": [],
				"policy": {
					"timeout": "0.12:00:00",
					"retry": 0,
					"retryIntervalInSeconds": 30,
					"secureOutput": false,
					"secureInput": false
				},
				"userProperties": [],
				"typeProperties": {
					"dataset": {
						"referenceName": "load_ds_csv1",
						"type": "DatasetReference",
						"parameters": {
							"Hos_name": {
								"value": "@pipeline().parameters.FolderDB_Name",
